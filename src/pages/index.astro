---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import {
  about,
  education,
  experience,
  profile,
  projects,
  strengths,
  technologies,
} from '../data/profile';
import profilePhoto from '../imgs/perfil.jpeg';

const slideLabels = ['About', 'Experience', 'Work', 'Education', 'Skills', 'Contact'];
const totalSlides = slideLabels.length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: profile.email,
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'PT',
  },
  worksFor: {
    '@type': 'Organization',
    name: 'Techbridge',
    url: profile.techbridge,
  },
};
---
<BaseLayout
  title={`${profile.name} — ${profile.role}`}
  description={`${profile.name} is a software developer and product builder based in Portugal.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  <header class="topbar">
    <div class="identity">
      <button class="identity-mark" type="button" aria-label="Ampliar fotografia de André Farinha" data-open-photo>
        <img src={profilePhoto.src} alt="André Farinha" width="38" height="38" decoding="async" />
      </button>
      <a class="identity-details" href="#about" data-go="0" aria-label="Voltar ao início">
        <strong>{profile.name}</strong>
        <small>{profile.role}</small>
      </a>
    </div>

    <div class="top-controls">
      <span class="current-label" aria-live="polite">About</span>
      <span class="counter" aria-live="polite">01 / 0{totalSlides}</span>
      <button class="arrow-button desktop-only" type="button" data-prev aria-label="Previous slide">←</button>
      <button class="arrow-button" type="button" data-next aria-label="Next slide">→</button>
    </div>
  </header>

  <dialog class="profile-photo-dialog" id="profile-photo-dialog" aria-label="Fotografia de André Farinha">
    <button class="photo-close" type="button" aria-label="Fechar fotografia" data-close-photo>×</button>
    <img src={profilePhoto.src} alt="André Farinha" width="1599" height="722" />
  </dialog>

  <main class="deck" id="deck">
    <section class="slide is-active" id="about" data-title="About">
      <div class="slide-inner hero-grid">
        <div class="hero-copy reveal">
          <p class="eyebrow">Personal portfolio</p>
          <h1>Hello, I’m <span>{profile.name.split(' ')[0]}.</span></h1>
          <p class="hero-role">{profile.role}</p>
          <p class="hero-description">{about.intro}</p>
          <div class="hero-links">
            <button class="primary-link" type="button" data-go="2">View my work</button>
            <a class="secondary-link" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
          </div>
        </div>

        <aside class="profile-summary reveal" aria-label="Profile summary">
          <div>
            <small>Based in</small>
            <strong>{profile.location}</strong>
          </div>
          <div>
            <small>Current role</small>
            <strong>Founder at Techbridge</strong>
          </div>
          <div>
            <small>Education</small>
            <strong>CTeSP + BSc</strong>
          </div>
          <p>{about.detail}</p>
          <a href={profile.techbridge} target="_blank" rel="noreferrer">More about Techbridge ↗</a>
        </aside>
      </div>
    </section>

    <section class="slide" id="experience" data-title="Experience">
      <div class="slide-inner split-layout">
        <div class="section-heading reveal">
          <p class="eyebrow">Experience</p>
          <h2>Where I have worked.</h2>
          <p>A short overview of my professional path so far.</p>
        </div>

        <div class="timeline reveal">
          {experience.map((item) => (
            <article class="timeline-item">
              <div class="timeline-meta">
                <span>{item.period}</span>
                <strong>{item.organisation}</strong>
              </div>
              <div class="timeline-content">
                <h3>{item.role}</h3>
                <p>{item.description}</p>
                <ul>
                  {item.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
                {item.href && (
                  <a href={item.href} target="_blank" rel="noreferrer">Visit {item.organisation} ↗</a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="slide" id="work" data-title="Work">
      <div class="slide-inner work-layout">
        <div class="section-heading compact reveal">
          <p class="eyebrow">Work I have done</p>
          <h2>Selected products and projects.</h2>
          <p>Most client work was created through <a href={profile.techbridge} target="_blank" rel="noreferrer">Techbridge ↗</a>.</p>
        </div>

        <div class="project-grid reveal">
          {projects.map((project) => (
            <article class="project-card">
              <div class="project-topline">
                <span>{project.type}</span>
                {project.href && <a href={project.href} target="_blank" rel="noreferrer" aria-label={`Open ${project.name}`}>↗</a>}
              </div>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <ul>
                {project.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="slide" id="education" data-title="Education">
      <div class="slide-inner split-layout">
        <div class="section-heading reveal">
          <p class="eyebrow">Education</p>
          <h2>Academic background.</h2>
          <p>My education combines a practical technical course with a broader degree in software and multimedia.</p>
        </div>

        <div class="education-list reveal">
          {education.map((item, index) => (
            <article class="education-card">
              <span>0{index + 1}</span>
              <div>
                <h3>{item.qualification}</h3>
                <strong>{item.institution}</strong>
                <p>{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="slide" id="skills" data-title="Skills">
      <div class="slide-inner skills-layout">
        <div class="section-heading reveal">
          <p class="eyebrow">Skills and technologies</p>
          <h2>What I work with.</h2>
          <p>I am comfortable moving between product decisions, interfaces, backend systems and delivery.</p>
        </div>

        <div class="skills-content reveal">
          <section>
            <h3>Areas</h3>
            <div class="pill-list">
              {strengths.map((item) => <span>{item}</span>)}
            </div>
          </section>
          <section>
            <h3>Technologies</h3>
            <div class="pill-list technologies">
              {technologies.map((item) => <span>{item}</span>)}
            </div>
          </section>
        </div>
      </div>
    </section>

    <section class="slide" id="contact" data-title="Contact">
      <div class="slide-inner contact-layout">
        <div class="contact-copy reveal">
          <p class="eyebrow">Contact</p>
          <h2>Thanks for visiting.</h2>
          <p>You can find more about my work through my LinkedIn profile or Techbridge.</p>
        </div>

        <div class="contact-links reveal">
          <a href={profile.linkedin} target="_blank" rel="noreferrer">
            <small>LinkedIn</small>
            <strong>Connect with me</strong>
            <span>↗</span>
          </a>
          <a href={profile.techbridge} target="_blank" rel="noreferrer">
            <small>Techbridge</small>
            <strong>View the company website</strong>
            <span>↗</span>
          </a>
          <a href={`mailto:${profile.email}`}>
            <small>Email</small>
            <strong>{profile.email}</strong>
            <span>↗</span>
          </a>
          {profile.github && (
            <a href={profile.github} target="_blank" rel="noreferrer">
              <small>GitHub</small>
              <strong>View public code</strong>
              <span>↗</span>
            </a>
          )}
        </div>

        <small class="footer-note">© 2026 {profile.name}. Built with Astro.</small>
      </div>
    </section>
  </main>

  <nav class="slide-nav" aria-label="Slide navigation">
    {slideLabels.map((label, index) => (
      <button class={index === 0 ? 'active' : ''} data-go={index} aria-label={`Go to ${label}`} title={label}>
        <span>{String(index + 1).padStart(2, '0')}</span>
        <i></i>
      </button>
    ))}
  </nav>

  <script is:inline>
    const photoDialog = document.querySelector('#profile-photo-dialog');
    document.querySelector('[data-open-photo]')?.addEventListener('click', () => photoDialog?.showModal());
    document.querySelector('[data-close-photo]')?.addEventListener('click', () => photoDialog?.close());
    photoDialog?.addEventListener('click', (event) => {
      if (event.target === photoDialog) photoDialog.close();
    });

    const deck = document.querySelector('#deck');
    const slides = [...document.querySelectorAll('.slide')];
    const indicators = [...document.querySelectorAll('.slide-nav button')];
    const counter = document.querySelector('.counter');
    const currentLabel = document.querySelector('.current-label');
    const nextButton = document.querySelector('[data-next]');
    const prevButton = document.querySelector('[data-prev]');
    let activeIndex = 0;
    let wheelLocked = false;

    const isDesktop = () => window.matchMedia('(min-width: 861px)').matches;

    function updateUi(index) {
      activeIndex = Math.max(0, Math.min(index, slides.length - 1));
      slides.forEach((slide, slideIndex) => slide.classList.toggle('is-active', slideIndex === activeIndex));
      indicators.forEach((indicator, indicatorIndex) => indicator.classList.toggle('active', indicatorIndex === activeIndex));
      counter.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      currentLabel.textContent = slides[activeIndex].dataset.title || '';
      nextButton.textContent = activeIndex === slides.length - 1 ? '↺' : '→';
    }

    function goTo(index) {
      const targetIndex = index < 0 ? slides.length - 1 : index >= slides.length ? 0 : index;
      slides[targetIndex].scrollTop = 0;
      slides[targetIndex].scrollIntoView({ behavior: 'smooth', block: 'start', inline: 'start' });
      updateUi(targetIndex);
    }

    document.querySelectorAll('[data-go]').forEach((element) => {
      element.addEventListener('click', (event) => {
        event.preventDefault();
        goTo(Number(element.dataset.go));
      });
    });

    nextButton.addEventListener('click', () => goTo(activeIndex + 1));
    prevButton?.addEventListener('click', () => goTo(activeIndex - 1));

    window.addEventListener('keydown', (event) => {
      if (['ArrowRight', 'PageDown'].includes(event.key)) {
        event.preventDefault();
        goTo(activeIndex + 1);
      }
      if (['ArrowLeft', 'PageUp'].includes(event.key)) {
        event.preventDefault();
        goTo(activeIndex - 1);
      }
      if (event.key === 'Home') goTo(0);
      if (event.key === 'End') goTo(slides.length - 1);
    });

    deck.addEventListener('wheel', (event) => {
      if (!isDesktop() || wheelLocked || Math.abs(event.deltaY) < 12) return;

      const currentSlide = slides[activeIndex];
      const canScrollInside = currentSlide.scrollHeight > currentSlide.clientHeight + 4;
      const movingForward = event.deltaY > 0;
      const atStart = currentSlide.scrollTop <= 1;
      const atEnd = currentSlide.scrollTop + currentSlide.clientHeight >= currentSlide.scrollHeight - 1;

      if (canScrollInside && ((movingForward && !atEnd) || (!movingForward && !atStart))) return;

      event.preventDefault();
      wheelLocked = true;
      goTo(activeIndex + (movingForward ? 1 : -1));
      window.setTimeout(() => { wheelLocked = false; }, 600);
    }, { passive: false });

    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible) updateUi(slides.indexOf(visible.target));
    }, { root: deck, threshold: [0.55, 0.75] });

    slides.forEach((slide) => observer.observe(slide));
    updateUi(0);
  </script>
</BaseLayout>
